# ---------- Server ----------
PORT=3000
# Where the SQLite database lives (mount a volume here in production)
DATA_DIR=./data
# Used when the browser does not send its time zone
DEFAULT_TIMEZONE=Europe/Moscow

# ---------- LLM (optional) ----------
# Without any key the assistant runs on the built-in Russian rule engine.
# auto | anthropic | openai | none
LLM_PROVIDER=auto

# Claude (preferred)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — low keeps voice latency down
LLM_EFFORT=low

# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, YandexGPT, local Ollama…
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# ---------- Semantic search (optional) ----------
# OpenAI-compatible embeddings; falls back to OPENAI_API_KEY if set
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ---------- Server-side speech recognition (optional) ----------
# Only needed for browsers without the Web Speech API (e.g. Firefox)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
